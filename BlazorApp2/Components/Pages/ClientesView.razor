@page "/clientes"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using BlazorApp2.Utils
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject ServiceClientes ClienteService
@inject NegocioService serviceNegocio
@inject ServiceUserNegocio serviceUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Clientes</PageTitle>

<h2>Clientes</h2>

 @if (!string.IsNullOrEmpty(MensajeEstado))
{
    <div class="alert alert-info mt-3">@MensajeEstado</div>
}

<!-- Filtro de búsqueda -->

<div class="row">
    <div class="col-6">
        <div class="input-group flex-nowrap">
            <span class="input-group-text" id="addon-wrapping">Buscar</span>
            <input type="text" class="form-control" placeholder="Por nombre, apellido, sector..." aria-describedby="addon-wrapping" @bind="searchTerm" />
        </div>
    </div>

    <div class="col-2">
        <button class="btn btn-primary  mb-0 me-2" @onclick="AgregarCliente">
            <i class="bi bi-file-earmark-arrow-down me-2"></i>
            Agregar
        </button>
    </div>

    <div class="col-2">

        <button class="btn btn-success" @onclick="ExportarDatos">
            <i class="fas fa-file-excel"></i>Exportar
        </button>

    </div>

 </div>



<!--modal de ejemplo para ingreso-->
<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Registrar-Clientes</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                ...
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary">Guardar</button>
            </div>
        </div>
    </div>
</div>

@if (clientes == null)
{
    // <p>Cargando clientes...</p>
}
else if (clientes.Count == 0)
{
    <p>No hay clientes disponibles.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
            <thead>
                <tr>
                    
                    <th>NOMBRE</th>
                    <th>SECTOR</th>
                    <th>ESTADO</th>
                    <th>ACCION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in FiltrarClientes)
                {
                    <tr>                        
                        <td>@cliente.adcu_name</td>
                        <td>@cliente.adcu_direction</td>                        
                        <td>
                            <!-- Switch para el campo 'Activo' -->
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="cliente.adcu_estado" disabled>
                            </div>
                        </td>
                        <td>
                            <!-- Botón de editar -->
                            <button class="btn btn-success btn-sm" @onclick="() => EditarCliente(cliente.adcu_code)">
                                <i class="fas fa-edit"></i>
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}



@code {
    // Aquí debes declarar la variable
    private List<Clientes> clientes,clientesExport;
    private string searchTerm = string.Empty;
    private Negocio negocio;
    private int idNegocio = 5;
    private string MensajeEstado = string.Empty;

    // Este método se ejecuta cuando el componente se inicializa
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var userClaims = user.Identities.First().Claims.ToList();
            
            idNegocio = serviceUser.getIdNegocioByUser(userClaims[0].Value);
            clientes = await ClienteService.GetClientesAsyncPage(idNegocio);

        } catch (Exception ex)
        {
            Console.WriteLine(ex.Message);

        }

        
        
    }

    private void AgregarCliente()
    {
        NavigationManager.NavigateTo($"/RegistrarClientes");

    }

    private void EditarCliente(int id)
    {
        NavigationManager.NavigateTo($"/RegistrarClientes/{id}");
    }

    private async Task ExportarDatos()
    {
        try
        {
            MensajeEstado = "Generando archivo...";
            //se genera los datos
            clientesExport = await ClienteService.GetClientesAsync(idNegocio);

            // Llama a tu función genérica de exportación
            var excelStream = ExportExcel.ExportToExcel(clientesExport, "ReporteClientes.xlsx", "Lista de Clientes");

            // --- Opción 1: Descargar el archivo directamente en el navegador (recomendado para Blazor) ---
            // Usa JavaScript para descargar el MemoryStream como un archivo
            await JSRuntime.InvokeVoidAsync("saveAsFile", "ReporteClientes.xlsx", Convert.ToBase64String(excelStream.ToArray()));

            MensajeEstado = "";
        }
        catch (Exception ex)
        {
            MensajeEstado = $"Error al exportar a Excel: {ex.Message}";
            MensajeEstado = "";
            // Aquí podrías loggear el error
        }
    }


    private IEnumerable<Clientes> FiltrarClientes =>
         clientes.Where(cliente => string.IsNullOrEmpty(searchTerm) || cliente.adcu_name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || cliente.adcu_direction.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));
}