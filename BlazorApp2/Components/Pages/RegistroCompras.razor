@page "/registroCompras"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject ProductoServices productoServices
@inject NegocioService serviceNegocio
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]

<h2>RegistroCompras</h2>

<!--CABCERA DE COMPRAS-->

<div class="container mt-5">
	<div class="border p-4 rounded">
	<div class="row">
		<div class="col-md-12">
			<div class="row">
				<div class="col-md-6">
					<div class="row">

						<div class="col-md-6">
							<label for="nombre" class="form-label">Registro</label>
						</div>
						<div class="col-md-6">
							<input type="text" class="form-control" placeholder="000012" aria-describedby="addon-wrapping" />
						</div>

						<div class="col-md-6">
							<label for="nombre" class="form-label">Factura</label>
						</div>

						<div class="col-md-6">
							<input type="text" class="form-control" placeholder="000012" aria-describedby="addon-wrapping" />
						</div>

						<div class="col-md-6">
							<label for="nombre" class="form-label">Proveedor</label>
						</div>

						<div class="col-md-6">
							<input type="text" class="form-control" placeholder="Buscar proveedor.." aria-describedby="addon-wrapping" />
						</div>

					</div>
				</div>
				<div class="col-md-6">
					<div class="row">
						
						<div class="col-md-6">
							<label for="nombre" class="form-label">Razon Social</label>
						</div>

						<div class="col-md-6">
							<input type="text" class="form-control"  aria-describedby="addon-wrapping" />
						</div>
												

						<div class="col-md-6">
							<label for="nombre" class="form-label">Fecha</label>
						</div>

						<div class="col-md-6">
							<input type="date" class="form-control" id="fecha" name="fecha">
						</div>


					</div>

						
				</div>
			</div>
		</div>
	</div>
</div>
</div>

<!--DETALLE DE COMPRAS-->

<div class="container mt-5">
	<div class="border p-4 rounded">

		<div class="table-responsive">
			<table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
				<thead>
					<tr>
						<th>COD-SOFADCON</th>
						<th>DESCRIPCION</th>
						<th>CANTIDAD</th>
						<th>VALOR</th>
						<th>IVA</th>
						<th>ICE</th>
					</tr>
				</thead>
				<tbody>
					
				</tbody>
			</table>
		</div>



    </div>
</div>

<div class="container mt-5">
    <div class="border p-4 rounded">

        <div class="row">
            <div class="col-md-8">

                <!-- Botón Guardar -->
                <button type="submit" class="btn btn-primary">Guardar</button>

            </div>
            <div class="col-md-4">

                <div class="col-md-6">
                    <label for="nombre" class="form-label">Subtotal</label>
                </div>

                <div class="col-md-6">
					<input type="number" step="0.01" class="form-control" aria-describedby="addon-wrapping" />
                </div>

                <div class="col-md-6">
                    <label for="nombre" class="form-label">Total</label>
                </div>

                <div class="col-md-6">
					<input type="number" step="0.01" class="form-control" aria-describedby="addon-wrapping" />
                </div>

            </div>
        </div>
    </div>
</div>

@code {

}
