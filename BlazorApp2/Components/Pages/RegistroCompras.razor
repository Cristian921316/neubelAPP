@page "/registroCompras"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using BlazorApp2.Models.VIEWS
@using Microsoft.AspNetCore.Authorization
@using System.Diagnostics
@rendermode InteractiveServer
@inject ProductoServices productoServices
@inject NegocioService serviceNegocio
@inject ServiceCabeceraCompra serviceCabeceraCompra
@inject ServiceDetalleCompra serviceDetalleCompra
@inject TipoTrxProductoServices tipoTrx
@inject ProveedorServices proveedorService
@inject ServiceUserNegocio serviceUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>Compras</PageTitle>

@if (mesageError)
{
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		@strMensajeMostrar
		<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
	</div>
}

<div class="row">

	<div class="col-9">
		<div class="input-group flex-nowrap">
			<span class="input-group-text" id="addon-wrapping">Buscar</span>
			<input type="text" class="form-control" placeholder="Por factura,proveedor" aria-describedby="addon-wrapping" @bind="searchTerm" />
		</div>
	</div>

	<div class="col-3">
		<button class="btn btn-primary  mb-0 me-2" @onclick="AgregarCompra">
			<i class="bi bi-file-earmark-arrow-down me-2"></i>
			Agregar
		</button>
	</div>

</div>



<!--Detalle de listado de compras-->
<div class="container mt-5">
	<div class="border p-4 rounded">

		<div class="table-responsive">
			<table class="table table-striped table-bordered table-hover table-compras" style="font-size: 10px;">
				<thead>
					<tr>
						<th>FACTURA</th>
						<th>PROVEEDOR</th>
						<th>COMPRADOR</th>
						<th>OBSERVACION</th>
						<th>VALOR</th>						
						<th>REGISTRO</th>
						<th>ACCION</th>						
					</tr>
				</thead>
				<tbody>

					@foreach (var compra in FiltrarCompras)
					{
						<tr>
							<td>@compra.Factura</td>
							<td>@compra.Proveedor</td>
							<td>@compra.Comprador</td>
							<td>@compra.Observacion</td>
							<td>@compra.Valor</td>
							<td>@compra.Registro</td>
							<td>
								<!-- Botón de editar -->
								<button class="btn btn-success btn-sm" @onclick="() => VisualizarCompra(compra)">
									<i class="fa-regular fa-eye"></i>
								</button>

							</td>
						</tr>
					}


				</tbody>
			</table>
		</div>

	</div>
</div>

@* --- El Modal Registro --- *@
<div class="modal fade" id="registroComprasModal" tabindex="-1" aria-labelledby="registroComprasModalLabel" aria-hidden="true">
	<div class="modal-dialog modal-xl">
		@* Usar modal-lg para un formulario grande *@
		<div class="modal-content">

			<div class="modal-header">
				<h1 class="modal-title fs-5" id="exampleModalLabel">Registrar</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" @onclick="() => CerrarModalView()"  aria-label=" Cerrar"></button>
			</div>

			<div class="modal-body">
				
				@* --- ¡RENDERIZACIÓN CONDICIONAL AQUÍ! --- *@
                @if (mostrarFormularioModal)
                {
					<FormularioRegistroCompras OnFormSubmitted="HandleFormSubmitted" />
                }
                else
                {
                    <p>Cargando formulario...</p> 
                }


			</div>			
		</div>
	</div>
</div>

@* --- El Modal lectura --- *@
<div class="modal fade" id="compraLectura" tabindex="-1" aria-labelledby="compraLecturaLabel" aria-hidden="true">
	<div class="modal-dialog modal-lg">
		@* Usar modal-lg para un formulario grande *@
		<div class="modal-content">			

			<div class="modal-body">

				<div class="modal-header">
					<h1 class="modal-title fs-5" id="exampleModalLabel">Informacion Compra</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
				</div>

				<div class="container mt-4">


					<div class="card mb-4">
						<div class="card-body">
							<div class="row mb-3">
								<div class="col-md-6">
									<label for="factura" class="form-label small-font">Factura</label>
									<input type="text" id="factura" class="form-control form-control-sm small-font-input" @bind="_factura" disabled>
								</div>
								<div class="col-md-6">
									<label for="comprador" class="form-label small-font">Comprador</label>
									<input type="text" id="comprador" class="form-control form-control-sm small-font-input" @bind="_comprador" disabled>
								</div>
							</div>
							<div class="row mb-3">
								<div class="col-md-6">
									<label for="registro" class="form-label small-font">Fecha de Registro</label>
									<input type="date" id="registro" class="form-control form-control-sm small-font-input" @bind="_registro" disabled>
								</div>
								<div class="col-md-6">
									<label for="proveedor" class="form-label small-font">Proveedor</label>
									<input type="text" id="proveedor" class="form-control form-control-sm small-font-input" @bind="_proveedor" disabled>
								</div>
							</div>
						</div>
					</div>


					<div class="card">
						<div class="card-header">
							Detalle de Productos
						</div>
						<div class="card-body">
							<div class="table-responsive">
								<table class="table table-striped table-bordered table-hover table-compras" style="font-size: 12px;">
									<thead>
										<tr>
											<th>Producto</th>
											<th>Cantidad</th>
											<th>Precio Unitario</th>
											<th>Iva</th>
											<th>Total</th>
										</tr>
									</thead>
									<tbody>
										@foreach (var trxDetalle in detalles)
										{
											<tr>

												<td>@trxDetalle.adpro_nombre</td>
												<td>@trxDetalle.adtc_cantidad</td>
												<td>@trxDetalle.adtc_precioUnitario</td>
												<td>@trxDetalle.adtc_iva</td>
												<td>@trxDetalle.adtc_precio_total</td>

											</tr>
										}

									</tbody>
								</table>
							</div>
						</div>
					</div>

					<div class="container mt-5">
						<div class="border p-4 rounded">

							<div class="row">

								<div class="col-md-6">
								</div>

								<div class="col-md-6">
									<div class="row align-items-center mb-2">
										<div class="col-md-4">
											<label for="adcom_subtotal" class="form-label mb-0 text-md-end small-font">Subtotal:</label>
										</div>
										<div class="col-md-8">
											<input type="text" id="adcom_subtotal" class="form-control text-end form-control-sm small-font-input" @bind="_subtotal" disabled />
										</div>
									</div>

									<div class="row align-items-center mb-2">
										<div class="col-md-4">
											<label for="adcom_iva" class="form-label mb-0 text-md-end small-font">IVA:</label>
										</div>
										<div class="col-md-8">
											<input type="text" id="adcom_iva" class="form-control text-end form-control-sm small-font-input" @bind="_iva" disabled />
										</div>
									</div>

									<div class="row align-items-center mb-2">
										<div class="col-md-4">
											<label for="adcom_total" class="form-label mb-0 text-md-end small-font">Total:</label>
										</div>
										<div class="col-md-8">
											<input type="text" id="adcom_total" class="form-control text-end form-control-sm small-font-input" @bind="_total" disabled />
										</div>
									</div>
								</div>
							</div>


						</div>
					</div>



				</div>

		


			</div>
		</div>
	</div>
</div>




@code {

	private string idUser, searchTerm = string.Empty;
	private int negocioId;
	private string ModalId = "registroComprasModal"; // ID del modal para JS
	private string modalLectura = "compraLectura";
	private bool mostrarFormularioModal = false, mostrarCompraLectura = false; // <-- ¡La bandera clave! Inicialmente false.
	private List<ViewCompras> compras = new List<ViewCompras>();
	private List<DetalleCompra> detalles = new List<DetalleCompra>();
	Guid _idCompra = Guid.Empty;
	private string _factura, _comprador, _observacion,_proveedor;
	private int idNegocio = 5; //valor por defecto
	DateTime? _registro;
	private decimal _subtotal, _iva, _total;
	private bool mesageError=false;
	private string strMensajeMostrar = string.Empty;

	protected override async Task OnInitializedAsync()
	{

		try
		{
			var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
			var user = authState.User;
			var userClaims = user.Identities.First().Claims.ToList();
			idUser = userClaims[0].Value;

			idNegocio = serviceUser.getIdNegocioByUser(idUser);

			compras = serviceCabeceraCompra.getComprasAll(idNegocio);

		} catch (Exception ex)
		{
			mesageError = true;
			strMensajeMostrar = "[ERROR] " + ex.Message + " CONTACTE CON EL ADMINISTRADOR DEL SISTEMA";
			StateHasChanged();
			await Task.Delay(2000);
			mesageError = false;
			StateHasChanged();
			
		}

		


	}

	private async void AgregarCompra()
	{

		try
		{
			mostrarFormularioModal = true;
			// 2. Dispara un StateHasChanged para que Blazor re-renderice y muestre el formulario
			StateHasChanged(); // Esto es importante par

			await JSRuntime.InvokeVoidAsync("modalHandler.showModal", ModalId);




		} catch (Exception ex)
		{


		}


	}

	private async void VisualizarCompra(ViewCompras compra)
	{
		_idCompra = compra.IdCompra;
		_factura = compra.Factura;
		_proveedor = compra.Proveedor;
		_comprador = compra.Comprador;
		_observacion = compra.Observacion;
		_registro = compra.Registro;
		_subtotal = compra.Subtotal;
		_iva = compra.Iva;
		_total = compra.Valor;
		detalles = await serviceDetalleCompra.GetDetalleComprasAsync(compra.IdCompra);
		
		mostrarCompraLectura = true;
		// 2. Dispara un StateHasChanged para que Blazor re-renderice y muestre el formulario	
		StateHasChanged(); 
		await JSRuntime.InvokeVoidAsync("modalHandler.showModal", modalLectura);
		


	}

	private async void CerrarModalView()
	{

		mostrarCompraLectura = false;
		StateHasChanged();
		await JSRuntime.InvokeVoidAsync("modalHandler.hideModal", modalLectura);
		

	}

	// Este método se ejecuta cuando el formulario hijo (FormularioRegistroCompras) invoca OnFormSubmitted
	private async Task HandleFormSubmitted(bool success)
	{
		if (success)
		{
			Console.WriteLine("Formulario guardado exitosamente. Cerrando modal.");
			// ¡CRUCIAL! Llama a la función JavaScript para ocultar el modal
			await JSRuntime.InvokeVoidAsync("modalHandler.hideModal", ModalId);

			//Se envia actualizar las compras
			compras = serviceCabeceraCompra.getComprasAll(idNegocio);

			mostrarFormularioModal = false;
			StateHasChanged(); // Notificar a Blazor para que elimine el componente del DOM

			
		}
		else
		{
			
			Console.WriteLine("Operación de formulario no exitosa o cancelada. Modal permanece abierto.");
		}
	}



	private IEnumerable<ViewCompras> FiltrarCompras =>
	compras.Where(compra =>
		string.IsNullOrEmpty(searchTerm) ||
		(compra.Factura != null && compra.Factura.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
		(compra.Observacion != null && compra.Observacion.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
		(compra.Proveedor != null && compra.Proveedor.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
		(compra.Comprador != null && compra.Comprador.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));

}
