@page "/ReportePagos"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject PagoServices servicePagos
@inject NegocioService serviceNegocio
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]

<h3>Listado pagos</h3>

<!-- Se cargan los meses -->
<div class="mb-3">
    <label for="nombre" class="form-label">Periodo</label>
    <select class="form-select" @bind=@mesSeleccionado>
        @foreach (var mes in meses)
        {
            <option value="@mes">@mes</option>
        }
    </select>
</div>


<div class="container">
    <div class="row">
        <div class="col-md-4">
            <div class="p-3 border bg-light">
                <div class="form-group">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="pagado" name="opciones" @onchange="(e) => filtrarPagos(false)">
                        <label class="form-check-label" for="opcion1">Pagado</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="pendiente" name="opciones" @onchange="(e) => filtrarPagos(true)">
                        <label class="form-check-label" for="opcion2">Pendiente</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border bg-light">
                <div class="form-group">
                    <div class="form-group d-flex align-items-center">
                        <div>
                        <label for="pendiente" class="form-label mb-0 me-2">Pendiente:</label>
                        <input type="text" class="form-control" id="pendiente" @bind-value=@pendiente disabled style="width: 100px;">
                        </div>
                        <div>
                        <label for="pagado" class="form-label mb-0 me-2">Pagado:</label>
                        <input type="text" class="form-control" id="pagado" @bind-value=@pagado disabled style="width: 100px;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border bg-light">
                <div class="form-group d-flex align-items-center">
                <label for="total" class="form-label mb-0 me-2">Total:</label>
                    <input type="text" class="form-control" id="total" @bind-value=@total disabled style="width: 100px;">

                    <button class="btn btn-primary  mb-0 me-2" @onclick="DescargarExcel">
                        <i class="bi bi-file-earmark-arrow-down me-2"></i>
                        Exportar
                    </button>

                </div>
            </div>
        </div>
    </div>


    <div class="row">
        <div class="col-9">
            <div class="input-group flex-nowrap">
                <span class="input-group-text" id="addon-wrapping">Buscar</span>
                <input type="text" class="form-control" placeholder="Por nombre, sector, comprobante..." aria-describedby="addon-wrapping" @bind="searchTerm" />
                <button class="btn btn-primary  mb-0 me-2" @onclick="buscarBoton">
                    <i class="bi bi-file-earmark-arrow-down me-2"></i>
                    Buscar
                </button>
            </div>
        </div>

    </div>

</div>





    @if (pagosFiltrado == null)
    {
        // <p>Cargando clientes...</p>
    }    
   else if (pagosFiltrado.Count > 0)
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover" style="font-size: 14px;">
                <thead>
                    <tr>
                        <th>FECHA</th>
                        <th>CLIENTE</th>
                        <th>SECTOR</th>                        
                        <th>PERIODO</th>
                        <th>COMPROBANTE</th>
                        <th>OBSERVACION</th>
                        <th>ESTADO</th>
                        <th>VALOR</th>
                    </tr>
                </thead>
                <tbody>
                    @if (pagosFiltrado.Any())
                    {
                        @foreach (var pagoViewer in pagosFiltrado)
                        {
                            <tr>
                                <td>@pagoViewer.trxDate</td>
                                <td>@pagoViewer.clienteName</td>
                                <td>@pagoViewer.sector</td>                                
                                <td>@pagoViewer.periodo</td>
                                <td>@pagoViewer.comprobante</td>
                                <td>@pagoViewer.observacion</td>
                                <td>@pagoViewer.estado</td>
                                <td>@pagoViewer.valor</td>
                            </tr>
                        }

                    }


                </tbody>
            </table>
        </div>
    }
    





@code {

    private List<ViewerPagoTrx> pagosViewer;
    //private List<ViewerPagoTrx> pagosFiltrado;
    private string opcionSeleccionada;
    private int total, pagado, pendiente;
    private bool filtroAplicado = false;
    private static string searchTerm;
    private List<ViewerPagoTrx> pagosFiltrado = new List<ViewerPagoTrx>();
    private Negocio negocio;
    private string rutaLogo="";


    private string mesSeleccionado = "ENERO";

    private List<string> meses = new List<string>
    {
        "ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO",
        "JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            //se recupera el negocio por el usuario logeado
            negocio = await serviceNegocio.getByUser(user.Identity.Name);
            rutaLogo = negocio.adbu_logo;

            buscarBoton();
        } catch (Exception ex)
        {
            
        
        }


    }



    private async void buscarBoton()
    {
        try
        {


            pagosViewer = servicePagos.getPagosViewerVoid(negocio.adbu_code, mesSeleccionado);
            pagosFiltrado = pagosViewer;

            pagosFiltrado = pagosViewer.Where(pago => string.IsNullOrEmpty(searchTerm) ||
            pago.clienteName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            pago.sector.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            pago.comprobante.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)).ToList();

            contarPagos();

        } catch (Exception ex)
        {
            
        
        }

    }



    private async void contarPagos()
    {
        pagado = 0;
        pendiente=0;
        foreach (var pagos in pagosFiltrado)
        {
            if (!pagos.estado.Equals("PENDIENTE"))
            {
                pagado += 1;

            }
            else pendiente += 1;

        }
        total = pagado + pendiente;
    }

    private void filtrarPagos(bool selection)
    {
        if (selection)
        {
            selection = false;
            pagosFiltrado = pagosViewer.Where(pago => pago.estado.Contains("PENDIENTE", StringComparison.OrdinalIgnoreCase) &&
            (string.IsNullOrEmpty(searchTerm) ||
            pago.clienteName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            pago.sector.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            pago.comprobante.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))).ToList();


        }
        else if (!selection)
        {
            selection = true;
            pagosFiltrado = pagosViewer.Where(pago => !pago.estado.Equals("PENDIENTE") &&
            (string.IsNullOrEmpty(searchTerm) ||
            pago.clienteName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            pago.sector.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            pago.comprobante.Contains(searchTerm, StringComparison.OrdinalIgnoreCase))).ToList();

        }
        else
        {
            buscarBoton();

        }


        contarPagos();
    }

  

    [Inject] private ExportService ExportService { get; set; }

    private async Task DescargarExcel()
    {
        await ExportService.ExportarAExcel(pagosFiltrado,rutaLogo);
    }


    
       

       

}
