@page "/ReportePagos"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject PagoServices servicePagos
@inject NavigationManager NavigationManager


<h3>Listado pagos</h3>

<div class="container">
    <div class="row">
        <div class="col-md-4">
            <div class="p-3 border bg-light">
                <div class="form-group">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="pagado" name="opciones"  @onchange="(e) => filtrarPagos(false)">
                        <label class="form-check-label" for="opcion1">Pagado</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" id="pendiente" name="opciones" @onchange="(e) => filtrarPagos(true)">
                        <label class="form-check-label" for="opcion2">Pendiente</label>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border bg-light">
                <div class="form-group">
                    <div class="form-group d-flex align-items-center">
                    <label for="total" class="form-label mb-0 me-2">Pendiente:</label>
                        <input type="text" class="form-control" id="total" @bind-value=@pendiente disabled style="width: 100px;">
                        <label for="total" class="form-label mb-0 me-2">Pagado:</label>
                        <input type="text" class="form-control" id="total" @bind-value=@pagado disabled style="width: 100px;">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 border bg-light">
                <div class="form-group d-flex align-items-center">
                <label for="total" class="form-label mb-0 me-2">Total:</label>
                    <input type="text" class="form-control" id="total" @bind-value=@total disabled style="width: 100px;">

                    <button class="btn btn-primary  mb-0 me-2">
                        <i class="bi bi-file-earmark-arrow-down me-2"></i>
                        Exportar
                    </button>

                </div>
            </div>
        </div>
    </div>
</div>

@if (pagosViewer == null)
{
    // <p>Cargando clientes...</p>
}
else if (pagosViewer.Count == 0)
{
    <p>No hay clientes disponibles.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover">
            <thead>
                <tr>
                    <th>CLIENTE</th>
                    <th>SECTOR</th>
                    <th>AÑO</th>
                    <th>PERIODO</th>
                    <th>COMPROBANTE</th>
                    <th>VALOR</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pagoViewer in pagosFiltrado)
                {
                    <tr>
                        <td>@pagoViewer.clienteName</td>
                        <td>@pagoViewer.sector</td>
                        <td>@pagoViewer.anio</td>
                        <td>@pagoViewer.periodo</td>
                        <td>@pagoViewer.comprobante</td>
                        <td>@pagoViewer.valor</td>                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
}



@code {

    private List<ViewerPagoTrx> pagosViewer;
    private List<ViewerPagoTrx> pagosFiltrado;
    private string opcionSeleccionada;
    private int total, pagado, pendiente;
    private bool filtroAplicado = false;

    protected override async Task OnInitializedAsync()
    {
        pagosViewer = await servicePagos.getPagosViewer(1);
        pagosFiltrado = pagosViewer;
        total = pagosViewer.Count();
        contarPagos();
    }

    private async void contarPagos()
    {
        pagado = 0;
        pendiente=0;
        foreach (var pagos in pagosFiltrado)
        {
            if (!pagos.comprobante.Equals("PENDIENTE"))
            {
                pagado += 1;

            }
            else pendiente += 1;

        }
    }

    private void filtrarPagos(bool selection)
    {
        if (selection)
        {
            pagosFiltrado = pagosViewer.Where(pago => pago.comprobante.Contains("PENDIENTE", StringComparison.OrdinalIgnoreCase)).ToList();

        }
        else
        {
            pagosFiltrado = pagosViewer.Where(pago => !pago.comprobante.Equals("PENDIENTE")).ToList();

        }
        contarPagos();
    }

    // Método que se ejecuta automáticamente al cambiar la opción
    private void OnOpcionSeleccionadaChanged(string nuevaOpcion)
    {
        filtroAplicado = true;
        // Lógica de filtrado según la opción seleccionada
        if (nuevaOpcion == "opcion1")
        {
            // Lógica de filtro para opción 1
        }
        else if (nuevaOpcion == "opcion2")
        {
            // Lógica de filtro para opción 2
        }
    }

    // Propiedad con enlace que invoca el método al cambiar la opción
    private string OpcionSeleccionada
    {
        get => opcionSeleccionada;
        set
        {
            opcionSeleccionada = value;
            OnOpcionSeleccionadaChanged(opcionSeleccionada);
        }
    }







       

}
