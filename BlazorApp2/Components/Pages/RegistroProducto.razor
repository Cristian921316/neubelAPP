@page "/RegistrarProductos/{ProductoId:guid?}"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@rendermode InteractiveServer
@inject ServiceClientes ClienteService
@inject NegocioService serviceNegocio
@inject ProductoServices productoServices
@inject ServiceUserNegocio serviceUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]



<h1>@(ProductoId.HasValue ? "Editar Producto" : "Registrar Producto")</h1>


<div class="container mt-5">
    <div class="border p-4 rounded">

        <EditForm id="registroForm" Model="@productosSave" OnValidSubmit="GuardarProducto">

            <div class="mb-3">
                <label for="nombre" class="form-label">Cod-Sofadcon</label>
                <input type="text" class="form-control" @bind="productosSave.adpro_codigoalterno1" id="codSofadcon" required>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Descripcion</label>
                <input type="text" class="form-control" @bind="productosSave.adpro_descripcion" id="descripcion" required>
            </div>

            <!--validacion si es edicion o nuevo-->
            @if (guardarOK)
            {
                <div class="mb-3">
                    <label for="cantidad" class="form-label">Cantidad</label>
                    <input type="number" class="form-control" @bind="productosSave.adpro_cantidad" id="cantidad">
                </div>



            }
            else
            {
                <div class="mb-3">
                    <label for="cantidad" class="form-label">Cantidad</label>
                    <input type="number" class="form-control" @bind="productosSave.adpro_cantidad" id="cantidad" disabled>
                </div>

            }

            <div class="mb-3">
                <label for="valor" class="form-label">Valor</label>
                <input type="number" class="form-control" @bind="productosSave.adpro_valor" id="valor" step="0.01">
            </div>


            <div class="mb-3">
                <label for="observacion" class="form-label">Observacion</label>
                <input type="text" class="form-control" @bind="productosSave.adpro_observacion" id="observacion">
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="productosSave.adpro_iva">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Iva</label>
                </div>
            </div>

            <div class="mb-3">
                <label for="valorIva" class="form-label">Valor Iva</label>
                <input type="number" class="form-control" @bind="productosSave.adpro_valor_iva" id="valorIva" step="0.01" required>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="productosSave.adpro_ice">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Ice</label>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="productosSave.adpro_estado">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Estado</label>
                </div>
            </div>

            @if (mostrarMensaje)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    Registrado con éxito.
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (mostrarError)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @strMensajeError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <button type="submit" class="btn btn-primary">Guardar Registro</button>

        </EditForm>

    </div>
</div>


@code {

    [Parameter]
    public Guid? ProductoId { get; set; }

    // Aquí debes declarar la variable
    private List<Productos> productos;
    private string searchTerm = string.Empty, strMensajeError = string.Empty;
    private Negocio negocio;

    private bool mostrarMensaje = false,mostrarError=false, guardarOK = true;

    //objeto productos a guardar
    private Productos productosSave = new Productos();

    private string idUser;
    private int idNegocio;

    // Este método se ejecuta cuando el componente se inicializa
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userClaims = user.Identities.First().Claims.ToList();
        idUser = userClaims[0].Value;
        idNegocio = serviceUser.getIdNegocioByUser(idUser);


        if (ProductoId.HasValue)
        {
            productosSave = await productoServices.getById(ProductoId.Value);
            guardarOK = false;//es modificar

            if (productosSave == null)
            {
                // Navigation.NavigateTo("/clientes");
                NavigationManager.NavigateTo("/clientes");
            }
        }

    }

    private async Task GuardarProducto()
    {
        try
        {
            productosSave.adbu_code = idNegocio;
            productosSave.adpro_userupdate = idUser;

            //se valida si esta con iva que coloque el valor del iva
            if (productosSave.adpro_iva && productosSave.adpro_valor_iva<=0)
            {
                mostrarError = true;

                strMensajeError = "ERROR, Si tiene iva debe colocar un valor > 0";

                await Task.Delay(1000);
                mostrarError = false;
                StateHasChanged();

                return;
            }


            await productoServices.Guardar(productosSave, guardarOK);
            mostrarMensaje = true;
            //Navigation.NavigateTo("/clientes");
            StateHasChanged();
            productosSave = new Productos();
            //si se crea un nuevo cliente se envia la bandera como creacion
            guardarOK = true;
            // Desvanecer el mensaje después de 3 segundos
            await Task.Delay(1000);
            mostrarMensaje = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Manejo de errores
            Console.WriteLine($"Error al guardar el producto: {ex.Message}");
        }
    }

}
