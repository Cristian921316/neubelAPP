@page "/productos"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject ProductoServices productoServices
@inject NegocioService serviceNegocio
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Productos</PageTitle>

<h2>PRODUCTOS</h2>

@if (mostrarMensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Producto registrado con éxito.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}




<div class="container mt-5">


<div class="row">
    <div class="col-9">
        <div class="input-group flex-nowrap">
            <span class="input-group-text" id="addon-wrapping">Buscar</span>
            <input type="text" class="form-control" placeholder="Por descripcion, codigo..." aria-describedby="addon-wrapping" @bind="searchTerm" />
        </div>
    </div>

        <div class="col-3">
            <button class="btn btn-primary  mb-0 me-2" @onclick="AgregarProducto">
                <i class="bi bi-file-earmark-arrow-down me-2"></i>
                Agregar Producto
            </button>
        </div>

</div>

@if (productos == null)
{
    // <p>Cargando clientes...</p>
}
else if (productos.Count == 0)
{
    <p>No hay productos disponibles.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
            <thead>
                <tr>
                    <th>COD-SOFADCON</th>
                    <th>DESCRIPCION</th>
                    <th>CANTIDAD</th>
                    <th>VALOR</th>
                    <th>OBSERVACION</th>
                    <th>IVA</th>
                    <th>ICE</th>
                    <th>ESTADO</th>
                    <th>ACCION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in FiltrarProductos)
                {
                    <tr>
                        <td>@producto.adpro_codigoalterno1</td>
                        <td>@producto.adpro_descripcion</td>
                        <td>@producto.adpro_cantidad</td>
                        <td>@producto.adpro_valor</td>
                        <td>@producto.adpro_observacion</td>
                        <td>@producto.adpro_iva</td>
                        <td>@producto.adpro_ice</td>
                        <td>
                            <!-- Switch para el campo 'Activo' -->
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="producto.adpro_estado" disabled>
                            </div>
                        </td>

                        <td>
                            <!-- Botón de editar -->
                            <button class="btn btn-success btn-sm" style="padding: 0.1rem 0.3rem; font-size: 0.75rem;" @onclick="() => EditarProducto(producto.adpro_codigo)">
                                <i class="fas fa-edit"></i>
                            </button>

                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginador -->
    <div class="d-flex justify-content-between">
        <button class="btn btn-primary" @onclick="PaginaAnterior" disabled="@(paginaActual == 1)">Ant</button>
        <span>Página @paginaActual de @totalPaginas</span>
        <button class="btn btn-primary" @onclick="PaginaSiguiente" disabled="@(paginaActual == totalPaginas)">Sig</button>
    </div>

}

<!--FORMULARIO DE EDICION-->

</div>






@code {

    // Aquí debes declarar la variable
    private List<Productos> productos;
    private string searchTerm = string.Empty;
    private Negocio negocio;

    private bool mostrarMensaje = false, guardarOK = true;

    //objeto productos a guardar
    private Productos productosSave = new Productos();

    //paginador
    private int paginaActual = 1;
    private int registrosPorPagina = 20;
    private int totalPaginas;
    private int totalPendientes = 0;
    private int totalRegistros = 0;
    private string idUser;

    private string offcanvasId = "productoOffcanvas";

    private readonly IJSRuntime _jsRuntime;

    private bool _isDataLoaded = false; // <-- ¡Esta es la bandera clave!

    // Este método se ejecuta cuando el componente se inicializa
    protected override async Task OnInitializedAsync()
    {

        if (!_isDataLoaded)
        {
            
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            idUser = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            //se recupera el negocio por el usuario logeado
            negocio = await serviceNegocio.getByUser(user.Identity.Name);


            productos = await productoServices.getAllProductosAsync();

            _isDataLoaded = true; // Marca que los datos ya fueron cargados
        }
        

    }

    private async void  CargarDatos()
    {
        try
        {
            productos = await productoServices.getAllProductosAsync();

            /*totalRegistros = productos.Count;

            totalPaginas = (int)Math.Ceiling((double)totalRegistros / registrosPorPagina);

            productos = FiltrarProductos
                .OrderBy(c => c.adpro_descripcion)
                .Skip((paginaActual - 1) * registrosPorPagina)
                .Take(registrosPorPagina)
                .ToList();*/

        } catch (Exception ex)
        {
            Console.WriteLine(ex.Message);

        }


    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            CargarDatos();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            CargarDatos();
        }
    }

    private async Task AbrirOffcanvas()
    {
        // Muestra el offcanvas usando JavaScript
        await JSRuntime.InvokeVoidAsync("showOffcanvas", offcanvasId);
    }

    private void EditarProducto(Guid id)
    {
        NavigationManager.NavigateTo($"/RegistrarProductos/{id}");

    }

    private void AgregarProducto()
    {
        NavigationManager.NavigateTo($"/RegistrarProductos");

    }

    private async Task GuardarProducto()
    {
        try
        {
            productosSave.adbu_code = negocio.adbu_code;
            productosSave.adpro_userupdate = idUser;


            //se marca como modificado


            await productoServices.Guardar(productosSave, guardarOK);
            mostrarMensaje = true;
            //Navigation.NavigateTo("/clientes");
            StateHasChanged();
             productosSave = new Productos();
            //si se crea un nuevo cliente se envia la bandera como creacion
            guardarOK = true;
            // Desvanecer el mensaje después de 3 segundos
            await Task.Delay(2000);
            mostrarMensaje = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Manejo de errores
            Console.WriteLine($"Error al guardar el producto: {ex.Message}");
        }
    }



    private IEnumerable<Productos> FiltrarProductos =>
         productos.Where(producto => string.IsNullOrEmpty(searchTerm) || producto.adpro_descripcion.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) );

}
