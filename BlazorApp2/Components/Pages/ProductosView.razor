@page "/productos"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject ProductoServices productoServices
@inject NegocioService serviceNegocio
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]

<PageTitle>Productos</PageTitle>

<h2>PRODUCTOS</h2>



<div class="container mt-4">


    <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="registrar-tab" data-bs-toggle="tab" data-bs-target="#registrar" type="button" role="tab" aria-controls="registrar" aria-selected="true">Registrar</button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="listado-tab" data-bs-toggle="tab" data-bs-target="#listado" type="button" role="tab" aria-controls="listado" aria-selected="false">Listado</button>
        </li>
    </ul>

    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active" id="registrar" role="tabpanel" aria-labelledby="registrar-tab">
            <div class="p-3 border mt-3">
                
                <form>

                    <div class="mb-3">
                        <label for="nombre" class="form-label">Cod-Sofadcon</label>
                        <input type="text" class="form-control" id="nombre">
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Descripcion</label>
                        <input type="text" class="form-control" id="descripcion">
                    </div>

                    <div class="mb-3">
                        <label for="cantidad" class="form-label">Cantidad</label>
                        <input type="number" class="form-control" id="cantidad">
                    </div>

                    <div class="mb-3">
                        <label for="valor" class="form-label">Valor</label>
                        <input type="number" class="form-control" id="valor">
                    </div>

                    <div class="mb-3">
                        <label for="observacion" class="form-label">Observacion</label>
                        <input type="text" class="form-control" id="observacion">
                    </div>

                    <button type="submit" class="btn btn-primary">Guardar Registro</button>
                </form>
            </div>
        </div>
        <div class="tab-pane fade" id="listado" role="tabpanel" aria-labelledby="listado-tab">




            <div class="row">
                <div class="col-9">
                    <div class="input-group flex-nowrap">
                        <span class="input-group-text" id="addon-wrapping">Buscar</span>
                        <input type="text" class="form-control" placeholder="Por descripcion, codigo..." aria-describedby="addon-wrapping" @bind="searchTerm" />
                    </div>
                </div>

                <!-- <div class="col-3">
                     <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#exampleModal">Agregar</button>
                  </div> -->

            </div>

            @if (productos == null)
            {
                // <p>Cargando clientes...</p>
            }
            else if (productos.Count == 0)
            {
                <p>No hay productos disponibles.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
                        <thead>
                            <tr>
                                <th>COD-SOFADCON</th>
                                <th>DESCRIPCION</th>
                                <th>CANTIDAD</th>
                                <th>VALOR</th>
                                <th>OBSERVACION</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in FiltrarProductos)
                            {
                                <tr>
                                    <td>@producto.adpro_codigoalterno1</td>
                                    <td>@producto.adpro_descripcion</td>
                                    <td>@producto.adpro_cantidad</td>
                                    <td>@producto.adpro_valor</td>
                                    <td>@producto.adpro_observacion</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginador -->
                <div class="d-flex justify-content-between">
                    <button class="btn btn-primary" @onclick="PaginaAnterior" disabled="@(paginaActual == 1)">Ant</button>
                    <span>Página @paginaActual de @totalPaginas</span>
                    <button class="btn btn-primary" @onclick="PaginaSiguiente" disabled="@(paginaActual == totalPaginas)">Sig</button>
                </div>

            }


            </div>
        </div>
    </div>



<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

<script>
    // Obtener una referencia al formulario usando su ID
    const registroForm = document.getElementById('registroForm');

    // Agregar un "escuchador" de eventos para el evento 'submit' del formulario
    if (registroForm) { // Asegurarse de que el formulario exista antes de intentar agregar el evento
        registroForm.addEventListener('submit', function (event) {
            // Prevenir el comportamiento por defecto del envío del formulario (que recarga la página)
            event.preventDefault();

            // --- Aquí iría tu lógica para procesar el formulario ---
            // Por ejemplo, obtener los valores de los campos:
            const nombre = document.getElementById('nombre').value;
            const email = document.getElementById('email').value;

            console.log('Formulario enviado (simulado):');
            console.log('Nombre:', nombre);
            console.log('Email:', email);

            // Aquí podrías enviar los datos a un servidor usando fetch() o XMLHttpRequest
            // O actualizar la tabla de listado directamente en el cliente (si es solo para el ejemplo)

            // Opcional: Mostrar un mensaje de éxito o limpiar el formulario
            alert('Registro guardado (simulado)!');
            registroForm.reset(); // Limpia los campos del formulario
        });
    }
</script>






@code {

    // Aquí debes declarar la variable
    private List<Productos> productos;
    private string searchTerm = string.Empty;
    private Negocio negocio;

    //paginador
    private int paginaActual = 1;
    private int registrosPorPagina = 20;
    private int totalPaginas;
    private int totalPendientes = 0;
    private int totalRegistros = 0;

    // Este método se ejecuta cuando el componente se inicializa
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        //se recupera el negocio por el usuario logeado
        negocio = await serviceNegocio.getByUser(user.Identity.Name);

        productos = await productoServices.getAllProductosAsync();
        totalRegistros = productos.Count;

        CargarDatos();

    }

    private async void  CargarDatos()
    {

        

        
        totalPaginas = (int)Math.Ceiling((double)totalRegistros / registrosPorPagina);

     productos =  FiltrarProductos
            .OrderBy(c => c.adpro_descripcion)
            .Skip((paginaActual - 1) * registrosPorPagina)
            .Take(registrosPorPagina)
            .ToList();
    }

    private void PaginaAnterior()
    {
        if (paginaActual > 1)
        {
            paginaActual--;
            CargarDatos();
        }
    }

    private void PaginaSiguiente()
    {
        if (paginaActual < totalPaginas)
        {
            paginaActual++;
            CargarDatos();
        }
    }



    private IEnumerable<Productos> FiltrarProductos =>
         productos.Where(producto => string.IsNullOrEmpty(searchTerm) || producto.adpro_descripcion.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) );

}
