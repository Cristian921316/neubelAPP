@page "/productos"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using BlazorApp2.Utils
@using Microsoft.AspNetCore.Authorization
@inject ProductoServices productoServices
@inject NegocioService serviceNegocio
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject ProductoState productoState
@inject IJSRuntime JSRuntime
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>Productos</PageTitle>

<h2>PRODUCTOS</h2>

@if (mesageError)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @strMensajeMostrar
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!string.IsNullOrEmpty(MensajeEstado))
{
    <div class="alert alert-info mt-3">@MensajeEstado</div>
}


<div class="container mt-5">


<div class="row">
    <div class="col-6">
        <div class="input-group flex-nowrap">
            <span class="input-group-text" id="addon-wrapping">Buscar</span>
                <input type="text" class="form-control" placeholder="Por descripcion, codigo..." aria-describedby="addon-wrapping" @bind="searchTerm" @bind:event="oninput" @onkeydown="BuscarConEnter" />
        </div>
    </div>

        <div class="col-2">
            <button class="btn btn-primary  mb-0 me-2" @onclick="AgregarProducto">
                <i class="bi bi-file-earmark-arrow-down me-2"></i>
                Agregar
            </button>
        </div>

        <div class="col-2">

            <button class="btn btn-success" @onclick="ExportarDatos">
                <i class="fas fa-file-excel"></i>Exportar
            </button>

        </div>

</div>

    @if (productos == null || !productos.Any())
{
    <p>Cargando productos...</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
            <thead>
                <tr>
                    <th>COD-SOFADCON</th>
                    <th>DESCRIPCION</th>
                    <th>CANTIDAD</th>
                    <th>VALOR</th>
                    <th>OBSERVACION</th>
                    <th>IVA</th>
                    <th>ICE</th>
                    <th>ESTADO</th>
                    <th>ACCION</th>
                </tr>
            </thead>
            <tbody>
                    @foreach (var producto in productos)
                {
                    <tr>
                        <td>@producto.adpro_codigoalterno1</td>
                        <td>@producto.adpro_descripcion</td>
                        <td>@producto.adpro_cantidad</td>
                        <td>@producto.adpro_valor</td>
                        <td>@producto.adpro_observacion</td>
                        <td>@producto.adpro_iva</td>
                        <td>@producto.adpro_ice</td>
                        <td>
                            <!-- Switch para el campo 'Activo' -->
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="producto.adpro_estado" disabled>
                            </div>
                        </td>

                        <td>
                            <!-- Botón de editar -->
                            <button class="btn btn-success btn-sm" style="padding: 0.1rem 0.3rem; font-size: 0.75rem;" @onclick="() => EditarProducto(producto.adpro_codigo)">
                                <i class="fas fa-edit"></i>
                            </button>

                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>

   

}

<!--FORMULARIO DE EDICION-->

</div>


@code {

    // Aquí debes declarar la variable
    private List<Productos> productos,productosExport;
    private string searchTerm = string.Empty, strMensajeMostrar = string.Empty;
    private Negocio negocio;


    private bool mesageError = false, guardarOK = true;
    private string MensajeEstado = string.Empty;

    //objeto productos a guardar
    private Productos productosSave = new Productos();

    //paginador
    private int paginaActual = 1;
    private int registrosPorPagina = 10;
    private int totalPaginas;
    private int totalPendientes = 0;
    private int totalRegistros = 0;
    private string idUser;

    private string offcanvasId = "productoOffcanvas";

    private readonly IJSRuntime _jsRuntime;

    private bool _isDataLoaded = false; // <-- ¡Esta es la bandera clave!

    // Este método se ejecuta cuando el componente se inicializa
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (!_isDataLoaded)
            {
                productos = await productoServices.getAllProductosAsyncPage(1,10,"");                            
                _isDataLoaded = true;

            }

        } catch (Exception ex)
        {
            mesageError = true;
            strMensajeMostrar = "[ERROR] "+ex.Message +" CONTACTE CON EL ADMINISTRADOR DEL SISTEMA";
            StateHasChanged();
            await Task.Delay(2000);
            mesageError = false;
            StateHasChanged();

        }      


    }

    private async Task BuscarConEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            StateHasChanged();
            productos = await productoServices.getAllProductosAsyncPage(1, 10, searchTerm);

            // Lógica al presionar Enter
            Console.WriteLine($"Buscando: {searchTerm}");
            // Aquí puedes llamar a tu método de búsqueda o similar
        }
    }


    private async Task ExportarDatos()
    {
        try
        {
            MensajeEstado = "Generando archivo...";
            //se genera los datos
            productosExport = await productoServices.getAllProductosAsync();

            // Llama a tu función genérica de exportación
            var excelStream = ExportExcel.ExportToExcel(productosExport, "ReporteDeProductos.xlsx", "Lista de Productos");

            // --- Opción 1: Descargar el archivo directamente en el navegador (recomendado para Blazor) ---
            // Usa JavaScript para descargar el MemoryStream como un archivo
            await JSRuntime.InvokeVoidAsync("saveAsFile", "ReporteDeProductos.xlsx", Convert.ToBase64String(excelStream.ToArray()));

            MensajeEstado = "";
        }
        catch (Exception ex)
        {
            MensajeEstado = $"Error al exportar a Excel: {ex.Message}";
            MensajeEstado = "";
            // Aquí podrías loggear el error
        }
    }



    private void EditarProducto(Guid id)
    {
        NavigationManager.NavigateTo($"/RegistrarProductos/{id}");

    }

    private void AgregarProducto()
    {
        NavigationManager.NavigateTo($"/RegistrarProductos");

    }  

    

}
