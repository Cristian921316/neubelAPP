	<!-- Chart.js -->
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="chart-config.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<h1>Bienvenido   </h1> 



<div style="text-align: center;">
<img src=@rutaLogo width="200" a />
</div>


<br />

<div class="container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="row">
				<div class="col-md-6">
					<div class="card">
						<h5 class="card-header">
							TOTAL INGRESOS
						</h5>
						<div class="card-body">
							<p class="card-text">
								Card content
							</p>
						</div>
						<div class="card-footer">
							TOTAL: 100
						</div>
					</div>
				</div>
				<div class="col-md-6">
					<div class="card">
						<h5 class="card-header">
							TOTAL SALIDAS
						</h5>
						<div class="card-body">
							<p class="card-text">
								Card content
							</p>
