@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using BlazorApp2.Services
@using BlazorApp2.Models
@inject PagoServices servicePagos
@inject NegocioService serviceNegocio
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider
@attribute [Authorize]

<PageTitle>Home</PageTitle>




<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

	<!-- Chart.js -->
	<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
	<script src="chart-config.js"></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>

<h1>Bienvenido   </h1> 



<div style="text-align: center;">
<img src=@rutaLogo width="200" a />
</div>

<!-- Se cargan los meses -->
<div class="container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="row">
				<div class="col-md-4">
					<input type="text" class="form-control" id="pendiente" @bind-value=@mesSeleccionado disabled style="width: 300px;">
				</div>
				<div class="col-md-3">
					<a href="/ReportePagos"> Ver detalles</a>

				</div>
			</div>
		</div>
	</div>
</div>

<br/>

<div class="container-fluid">
	<div class="row">
		<div class="col-md-12">
			<div class="row">

				<div class="col-md-4">
					<div class="card">
						<h5 class="card-header">
							Clientes Pendientes
						</h5>

						<div class="card-body">

							@if (clientesPendientes != null && clientesPendientes.Count > 0)
							{
															

								<div class="table-responsive">
									<table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
										<thead>
											<tr>

												<th>NOMBRE</th>
												<th>SECTOR</th>
											</tr>
										</thead>
										<tbody>
											@foreach (var cliente in clientesPendientes)
											{
												<tr>
													<td>@cliente.clienteName</td>
													<td>@cliente.sector</td>

												</tr>
											}
										</tbody>
									</table>
								</div>

								<!-- Paginador -->
								<div class="d-flex justify-content-between">
									<button class="btn btn-primary" @onclick="PaginaAnterior" disabled="@(paginaActual == 1)">Ant</button>
									<span>Página @paginaActual de @totalPaginas</span>
									<button class="btn btn-primary" @onclick="PaginaSiguiente" disabled="@(paginaActual == totalPaginas)">Sig</button>
								</div>



							}


						</div>
						<div class="card-footer">
						</div>
					</div>
				</div>


				<div class="col-md-4">
					<div class="card">
						<h5 class="card-header">
							Detalle Pagos
						</h5>
						<div class="card-body">
							<p class="card-text">
								<div>

									<label for="pendiente" class="form-label mb-0 me-2">$ Recaudado</label>
									<input type="@inputType" class="form-label mb-0 me-2" id="total" @bind="totalRecaudado" disabled style="width: 100px;">
									<button class="btn btn-outline-secondary" type="button" id="toggleText" @onclick="AlternarVisibilidad">
										Ver
									</button>


								</div>

								<div>
									<label for="pendiente" class="form-label mb-0 me-2"># Pendientes</label>
									<input type="number" class="form-control" id="pendiente" @bind="pendiente" disabled style="width: 100px;">
								</div>
								<div>
									<label for="pagado" class="form-label mb-0 me-2"># Pagados</label>
									<input type="number" class="form-control" id="pagado" @bind="pagado" disabled style="width: 100px;">
								</div>
							</p>
						</div>
						<div class="card-footer">
						</div>
					</div>
				</div>




				<div class="col-md-4">
					<div class="card">
						<h5 class="card-header">
							Porcentaje Pagos
						</h5>
						<div class="card-body">
							<p class="card-text">

								<div class="d-flex justify-content-center">
									<canvas id="graficoPastel" width="200" height="200"></canvas>
								</div>

							</p>
						</div>
						<div class="card-footer">
							
						</div>
					</div>
				</div>
				
							

			</div>
		</div>
	</div>
</div>






@code {
	// Datos dinámicos
	private string[] etiquetas = { "Pagado", "Pendiente" };
	private List<decimal?> valores = new List<decimal?>();
	private int[] valoresArreglo = { 45, 55 };
	private List<ViewerPagoTrx> pagosViewer,clientesPendientes;
	private Negocio negocio;
	private decimal? total, pagado, pendiente;
	private decimal? porcenPagado, porcenPendiente,totalRecaudado;
	private string inputType = "password"; // Tipo inicial (oculto)
	private string iconoClase = "bi bi-eye"; // Ícono inicial
	private string rutaLogo="";

	//renderizado de pastel.
	private IJSObjectReference? chartInstance;

	private string mesSeleccionado;

	private ChangeEventArgs eventCambio = new ChangeEventArgs();

	//paginador
	private int paginaActual = 1;
	private int registrosPorPagina = 10;
	private int totalPaginas;



	private List<string> meses = new List<string>
	{
		"ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO",
		"JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"
	};

	protected override async Task OnInitializedAsync()
	{
		try
		{


			//se coloca el mes seleccionado del mes actual
			int numeroMes = DateTime.Now.Month - 1;

			mesSeleccionado = meses[numeroMes].ToUpper();

			eventCambio.Value = mesSeleccionado;

			//Se recuperan datos del negocio
			var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
			var user = authState.User;

			negocio = await serviceNegocio.getByUser(user.Identity.Name);
			rutaLogo = negocio.adbu_logo;



		} catch (Exception ex)
		{


		}


	}




	private void AlternarVisibilidad()
	{
		try
		{

			// Alternar entre 'text' y 'password'
			if (inputType == "password")
			{
				inputType = "text";
				//iconoClase = "bi bi-eye-slash"; // Cambiar el ícono
			}
			else
			{
				inputType = "password";
				//iconoClase = "bi bi-eye"; // Volver al ícono original
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine(ex.Message);

		}


	}



	private void contarPagos()
	{
		//se limpia la lista de valores.
		valores.Clear();
		pagado = 0;
		pendiente = 0;
		totalRecaudado = 0;
		foreach (var pagos in pagosViewer)
		{
			if (!pagos.estado.Equals("PENDIENTE"))
			{
				pagado += 1;
				totalRecaudado += pagos.valor;

			}
			else
			{
				pendiente += 1;


			}

		}
		total = pagado + pendiente;
		porcenPagado = (pagado / total) * 100;
		porcenPendiente = (pendiente / total) * 100;		
		valores.Add(porcenPagado);
		valores.Add(porcenPendiente);


	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		//se recupera el usuario logeado
		//var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		try
		{



			var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
			var user = authState.User;
			//se recupera el negocio por el usuario logeado
			negocio = await serviceNegocio.getByUser(user.Identity.Name);
			rutaLogo = negocio.adbu_logo;			

			//se obtiene la entidad para manejar los clientes pendientes
			//clientesPendientes = pagosViewer.Where(cp => cp.estado.Contains("PENDIENTE")).Take(20).ToList();

			pagosViewer = await servicePagos.getPagosViewer(negocio.adbu_code, mesSeleccionado);

			CargarDatos();
			contarPagos();

			if (firstRender)
			{
				// Llama al método de JavaScript para crear el gráfico
				await JSRuntime.InvokeVoidAsync("crearGraficoPastel", etiquetas, valores.ToArray());
				StateHasChanged();
			}
			else
			{
				//StateHasChanged();

			}


		} catch (Exception ex)
		{

			Console.WriteLine(ex.Message);

		}		

	}

	private void  CargarDatos()
	{
		clientesPendientes = pagosViewer.Where(cp => cp.estado.Contains("PENDIENTE")).ToList();

		var totalRegistros = clientesPendientes.Count;
		totalPaginas = (int)Math.Ceiling((double)totalRegistros / registrosPorPagina);

		clientesPendientes = clientesPendientes
			.OrderBy(c => c.trxDate)
			.Skip((paginaActual - 1) * registrosPorPagina)
			.Take(registrosPorPagina)
			.ToList();
	}

	private void PaginaAnterior()
	{
		if (paginaActual > 1)
		{
			paginaActual--;
			CargarDatos();
		}
	}

	private void PaginaSiguiente()
	{
		if (paginaActual < totalPaginas)
		{
			paginaActual++;
			CargarDatos();
		}
	}


	

}