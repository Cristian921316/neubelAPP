@page "/RegistrarClientes/{ClienteId:int?}"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore.Metadata.Internal
@rendermode InteractiveServer
@inject ServiceClientes ClienteService
@inject NegocioService serviceNegocio
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]

<h3>@(ClienteId.HasValue ? "Editar Cliente" : "Registrar Cliente")</h3>

@if (mostrarMensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Cliente registrado con éxito.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="container mt-5">
    <div class="border p-4 rounded">

        <EditForm id="registroForm" Model="@nuevoCliente" OnValidSubmit="GuardarCliente">

        <div class="mb-3">
            <label for="nombre" class="form-label">Cedula</label>
            <input type="text" class="form-control"  @bind="nuevoCliente.adcu_nationalid" id="cedula" name="cedula" placeholder="Ingresa cedula">
        </div>


        <!-- Campo Nombre -->
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
                <input type="text" class="form-control" @bind="nuevoCliente.adcu_name" id="nombre" name="nombre" placeholder="Ingresa nombre" required>
        </div>

        <div class="mb-3">
            <label for="nombre" class="form-label">Telefono</label>
                <input type="text" class="form-control" @bind="nuevoCliente.adcu_phone" id="telefono" name="telefono" placeholder="Ingresa telefono">
        </div>

        <!-- Campo Email -->
        <div class="mb-3">
            <label for="email" class="form-label">Correo Electrónico</label>
                <input type="email" class="form-control" @bind="nuevoCliente.adcu_email" id="email" name="email" placeholder="Ingresa tu email">
        </div>

        <div class="mb-3">
            <label for="nombre" class="form-label">Direccion</label>
                <input type="text" class="form-control" @bind="nuevoCliente.adcu_direction" id="direccion" name="direccion" placeholder="Ingresa direccion" required>
        </div>

            <div class="mb-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="flexSwitchCheckDefault" @bind="nuevoCliente.adcu_estado">
                    <label class="form-check-label" for="flexSwitchCheckDefault">Estado</label>
                </div>
            </div>


        <!-- Botón Guardar -->
        <button type="submit" class="btn btn-primary">Guardar</button>
    </EditForm>
</div>
</div>




@code {
    [Parameter]
    public int? ClienteId { get; set; }

    private Clientes nuevoCliente = new Clientes();  
    private bool mostrarMensaje = false,guardarOK=true;
    private ServiceClientes serviceClientes;
    private Negocio negocio;
    private string idUser;


    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        idUser = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        //se recupera el negocio por el usuario logeado
        negocio = await serviceNegocio.getByUser(user.Identity.Name);


        if (ClienteId.HasValue)
        {
            nuevoCliente = await ClienteService.getById(ClienteId.Value);
            guardarOK = false;//es modificar

            if (nuevoCliente == null)
            {
                // Navigation.NavigateTo("/clientes");
                NavigationManager.NavigateTo("/clientes");
            }
        }
        else //se trata de un nuevo cliente
        {
            // nuevoCliente = new Clientes();

        }
    }



    private async Task GuardarCliente()
    {
        try
        {
            nuevoCliente.adbu_code = negocio.adbu_code;
            nuevoCliente.adus_code = idUser;


            //se marca como modificado


            await ClienteService.GuardarCliente(nuevoCliente, guardarOK);
            mostrarMensaje = true;
            //Navigation.NavigateTo("/clientes");
            StateHasChanged();
            nuevoCliente = new Clientes();
            //si se crea un nuevo cliente se envia la bandera como creacion
            guardarOK = true;
            // Desvanecer el mensaje después de 3 segundos
            await Task.Delay(2000);
            mostrarMensaje = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Manejo de errores
            Console.WriteLine($"Error al guardar el cliente: {ex.Message}");
        }
    }
}
