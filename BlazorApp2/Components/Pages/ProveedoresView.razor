@page "/proveedores"
@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject ProveedorServices proveedoresService
@inject NegocioService serviceNegocio
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize]


<h2>Proveedores</h2>

<!-- Filtro de búsqueda -->
@if (mostrarMensaje)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        Registrado con éxito.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="row">
    <div class="col-9">
        <div class="input-group flex-nowrap">
            <span class="input-group-text" id="addon-wrapping">Buscar</span>
            <input type="text" class="form-control" placeholder="Por nombre, apellido, sector..." aria-describedby="addon-wrapping" @bind="searchTerm" />
        </div>
    </div>

    <div class="col-3">
        <button class="btn btn-primary  mb-0 me-2" @onclick="AgregarProveedor">
            <i class="bi bi-file-earmark-arrow-down me-2"></i>
            Agregar
        </button>
    </div>

</div>


@if (proveedores == null)
{
    // <p>Cargando clientes...</p>
}
else if (proveedores.Count == 0)
{
    <p>No hay proveedores disponibles.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
            <thead>
                <tr>

                    <th>RUC</th>
                    <th>NOMBRE</th>
                    <th>DIRECCION</th>
                    <th>ACCION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var prov in FiltrarProveedores)
                {
                    <tr>
                        <td>@prov.adprv_ruc</td>
                        <td>@prov.adprv_nombre</td>
                        <td>@prov.adprv_direccion</td>
                        <td>
                            <!-- Botón de editar -->
                            <button class="btn btn-success btn-sm" @onclick="() => EditarProveedor(prov.adprv_codigo)">
                                <i class="fas fa-edit"></i>
                            </button>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!--modal de ejemplo para ingreso-->
<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Registrar</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                
                <div class="container mt-5">
                    <div class="border p-2 rounded">

                        <EditForm id="registroForm" Model="@nuevoProv" OnValidSubmit="GuardarProveedor">

                            <div class="mb-3">
                                <label for="nombre" class="form-label">RUC</label>
                                <input type="text" class="form-control" @bind="nuevoProv.adprv_ruc" id="cedula" name="cedula" placeholder="Ingresa ruc">
                            </div>


                            <!-- Campo Nombre -->
                            <div class="mb-3">
                                <label for="nombre" class="form-label">Nombre</label>
                                <input type="text" class="form-control" @bind="nuevoProv.adprv_nombre" id="nombre" name="nombre" placeholder="Ingresa nombre" required>
                            </div>

                            <div class="mb-3">
                                <label for="nombre" class="form-label">Telefono</label>
                                <input type="text" class="form-control" @bind="nuevoProv.adprv_telefono" id="telefono" name="telefono" placeholder="Ingresa telefono">
                            </div>

                            <div class="mb-3">
                                <label for="nombre" class="form-label">Ciudad</label>
                                <input type="text" class="form-control" @bind="nuevoProv.adprv_ciudad" id="direccion" name="direccion" placeholder="Ingresa ciudad" required>
                            </div>

                            <div class="mb-3">
                                <label for="nombre" class="form-label">Direccion</label>
                                <input type="text" class="form-control" @bind="nuevoProv.adprv_direccion" id="direccion" name="direccion" placeholder="Ingresa direccion" required>
                            </div>

                            <!-- Campo Email -->
                            <div class="mb-3">
                                <label for="email" class="form-label">Correo Electrónico</label>
                                <input type="email" class="form-control" @bind="nuevoProv.adprv_email" id="email" name="email" placeholder="Ingresa tu email">
                            </div>
                          
                        </EditForm>
                    </div>
                </div>

                <div class="modal-footer">                   
                    <button type="button" class="btn btn-primary" @onclick="GuardarProveedor">Guardar</button>
                </div>

            </div>
            
        </div>
    </div>
</div>


@code {

    // Aquí debes declarar la variable
    private List<Proveedor> proveedores;
    private string searchTerm = string.Empty;
    private Negocio negocio;
    private bool guardaOK = true;
    private int idNegocio;
    private string ModalId = "exampleModal"; // ID de tu modal
    private Proveedor nuevoProv = new Proveedor();
    private string idUser;
    private bool mostrarMensaje=false;

    // Este método se ejecuta cuando el componente se inicializa
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        idUser = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        //se recupera el negocio por el usuario logeado
        negocio = await serviceNegocio.getByUser(user.Identity.Name);
        idNegocio = negocio.adbu_code;

        proveedores = await proveedoresService.getAllProveedorAsync(idNegocio);        


    }

    private async void AgregarProveedor()
    {
        //NavigationManager.NavigateTo($"/RegistrarProveedor");

        nuevoProv = new Proveedor();
        // Usa la función JS que gestiona la instancia del modal
        await JSRuntime.InvokeVoidAsync("modalHandler.showModal", ModalId);


    }

    private async void GuardarProveedor()
    {
        //NavigationManager.NavigateTo($"/RegistrarProveedor");

        await JSRuntime.InvokeVoidAsync("modalHandler.hideModal", ModalId);        
        nuevoProv.adbu_code = idNegocio;
        nuevoProv.adprv_userupdate = idUser;
        await proveedoresService.GuardarProveedor(nuevoProv,guardaOK);

        //se envia a recuperar los registros.
        proveedores = await proveedoresService.getAllProveedorAsync(idNegocio);

        //Actualiza mensj
        mostrarMensaje = true;
        //Navigation.NavigateTo("/clientes");
        StateHasChanged();

        await Task.Delay(1000);
        mostrarMensaje = false;
        StateHasChanged();

    }

    private async void EditarProveedor(Guid id)
    {
        nuevoProv = await proveedoresService.getById(id);
        StateHasChanged();
        // Usa la función JS que gestiona la instancia del modal
        await JSRuntime.InvokeVoidAsync("modalHandler.showModal", ModalId);
        guardaOK = false; // actualiza
    }

    private IEnumerable<Proveedor> FiltrarProveedores =>
         proveedores.Where(prov => string.IsNullOrEmpty(searchTerm) || prov.adprv_nombre.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));


}
