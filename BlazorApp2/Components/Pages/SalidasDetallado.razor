		(salida.CodSofadcom != null && salida.CodSofadcom.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
		(salida.Descripcion != null && salida.Descripcion.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
		(salida.Cliente != null && salida.Cliente.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)));*/


}
