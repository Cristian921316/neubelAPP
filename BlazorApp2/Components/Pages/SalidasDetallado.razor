@page "/salidasDetallado"
@using BlazorApp2.Models.VIEWS
@using BlazorApp2.Services
@using BlazorApp2.Models
@using BlazorApp2.Utils
@using Microsoft.AspNetCore.Authorization
@rendermode InteractiveServer
@inject ProductoServices productoServices
@inject NegocioService serviceNegocio
@inject ServiceCabeceraSalida sertviceCabeceraSalida
@inject ServiceDetalleSalida serviceDetalleSalida
@inject TipoTrxProductoServices tipoTrx
@inject ServiceClientes clienteService
@inject ServiceUserNegocio serviceUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@attribute [Authorize]

<PageTitle>SalidasDetallado</PageTitle>

@if (!string.IsNullOrEmpty(MensajeEstado))
{
	<div class="alert alert-info mt-3">@MensajeEstado</div>
}

<div class="row">

	<div class="col-8">
		<div class="input-group flex-nowrap">
			<span class="input-group-text" id="addon-wrapping">Buscar</span>
			<input type="text" class="form-control" placeholder="Por observacion, descripcion, cliente..." aria-describedby="addon-wrapping" @bind="searchTerm" @bind:event="oninput" @onkeydown="BuscarConEnter" />
		</div>
	</div>

	<div class="col-4 d-flex justify-content-end">
		
		<button class="btn btn-success" @onclick="ExportarDatos">
			<i class="fas fa-file-excel"></i> Exportar
		</button>
	</div>

</div>

<div class="container mt-5">
	<div class="border p-4 rounded">

		<div class="table-responsive">
			<table class="table table-striped table-bordered table-hover table-compras" style="font-size: 10px;">
				<thead>
					<tr>
						<th>FECHA_VENTA</th>
						<th>FECHA_REGISTRO</th>						
						<th>GUIA</th>
						<th>CLIENTE</th>
						<th>COD_SOFADCOM</th>
						<th>DESCRIPCION</th>
						<th>OBSERVACION</th>
						<th>CANTIDAD</th>
						<th>PRECIO</th>
						<th>TOTAL</th>
					</tr>
				</thead>
				<tbody>

					@foreach (var salida in salidasDetallado)
					{
						<tr>
							<td>@salida.FechaVenta</td>
							<td>@salida.FechaRegistro</td>							
							<td>@salida.Guia</td>
							<td>@salida.Cliente</td>
							<td>@salida.CodSofadcom</td>
							<td>@salida.Descripcion</td>
							<td>@salida.Observacion</td>
							<td>@salida.Cantidad</td>	
							<td>@salida.Precio</td>
							<td>@salida.Total</td>
						</tr>
					}


				</tbody>
			</table>
		</div>

	</div>
</div>




@code {
	private string idUser, searchTerm = string.Empty;
	private string MensajeEstado = string.Empty;
	private int idNegocio;
	private List<ViewSalidaDetallado> salidasDetallado = new List<ViewSalidaDetallado>();

	protected override async Task OnInitializedAsync()
	{


		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		var userClaims = user.Identities.First().Claims.ToList();
		idUser = userClaims[0].Value;

		idNegocio = serviceUser.getIdNegocioByUser(idUser);

		salidasDetallado = sertviceCabeceraSalida.getSalidaDetallado(idNegocio, "VISTA_SALIDA_DETALLADO","");


	}


	//ExportData
	private async void ExportarDatos()
	{
		try
		{
			StateHasChanged();
			MensajeEstado = "Generando archivo...";
			//se genera los datos


			// Llama a tu función genérica de exportación
			var excelStream = ExportExcel.ExportToExcel(salidasDetallado, "ReporteSalidasDetallado.xlsx", "Lista de Salidas");

			// --- Opción 1: Descargar el archivo directamente en el navegador (recomendado para Blazor) ---
			// Usa JavaScript para descargar el MemoryStream como un archivo
			await JSRuntime.InvokeVoidAsync("saveAsFile", "ReporteSalidasDetallado.xlsx", Convert.ToBase64String(excelStream.ToArray()));

			MensajeEstado = "";
			StateHasChanged();
		}
		catch (Exception ex)
		{
			MensajeEstado = $"Error al exportar a Excel: {ex.Message}";
			MensajeEstado = "";
			// Aquí podrías loggear el error
		}
	}

	private void BuscarConEnter(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			StateHasChanged();
			salidasDetallado = sertviceCabeceraSalida.getSalidaDetallado(idNegocio, "VISTA_SALIDA_DETALLADO", searchTerm);

			// Lógica al presionar Enter
			Console.WriteLine($"Buscando: {searchTerm}");
			// Aquí puedes llamar a tu método de búsqueda o similar
		}
	}

