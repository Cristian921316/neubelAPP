@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@using System.Diagnostics
@rendermode InteractiveServer
@inject ProductoServices productoServices
@inject NegocioService serviceNegocio
@inject ServiceCabeceraCompra serviceCabeceraCompra
@inject ServiceDetalleCompra serviceDetalleCompra
@inject TransaccProductoServices serviceTrxProductos
@inject TipoTrxProductoServices tipoTrx
@inject ProveedorServices proveedorService
@inject ServiceUserNegocio serviceUser
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@attribute [Authorize]


	<!--CABCERA DE COMPRAS-->
	@if (mostrarMensaje)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			Registro realizado con exito.
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}
	@if (mesageError)
	{
		<div class="alert alert-danger alert-dismissible fade show" role="alert">
			@strMensajeMostrar
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

<div class="container-fluid">
		<div class="border p-6 rounded">
			<div class="row">
				<div class="col-md-12">
					<div class="row">
						<div class="col-md-6">
							<div class="row">

								<div class="col-md-6">
									<label for="nombre" class="form-label">Tipo Ingreso</label>
								</div>
								<div class="col-md-6">
									<select class="form-select" @bind=cabeceraCompra.adtr_codigo>
										<option value="seleccionar">--Seleccionar--</option>
										@foreach (var tipo in tipoTrxProductos)
										{
											<option value="@tipo.adtr_codigo">@tipo.adtr_nombre</option>
										}
									</select>
								</div>


								<div class="col-md-6">
									<label for="nombre" class="form-label">Factura</label>
								</div>

								<div class="col-md-6">
								<input type="text" class="form-control" placeholder="###-###-#########" @bind="cabeceraCompra.adcom_factura" aria-describedby="addon-wrapping" />
								</div>

							</div>



						</div>
						<div class="col-md-6">
							<div class="row">

								<div class="col-md-6">
									<label for="nombre" class="form-label">Comprador</label>
								</div>

								<div class="col-md-6">
								<select class="form-select" @bind=cabeceraCompra.adcom_comprador>
										<option value="seleccionar">--Seleccionar--</option>
										<option value="CHRISTIAN OSMANI AGUILAR">CHRISTIAN OSMANI AGUILAR</option>
										<option value="DCMI">DCMI</option>
										<option value="MAVELA ARMIJOS">MAVELA ARMIJOS</option>
									</select>
								</div>


								<div class="col-md-6">
									<label for="nombre" class="form-label">Fecha</label>
								</div>

								<div class="col-md-6">
								<input type="date" class="form-control" @bind="cabeceraCompra.adcom_emision" aria-describedby="addon-wrapping" />
								</div>


							</div>


						</div>
					</div>
				</div>
			</div>
			<!--ingreso proveedores-->

			<div class="row">
				<div class="col-md-3">
					<label for="nombre" class="form-label">Proveedor</label>
				</div>

				<div class="col-md-9">

					<InputText id="proveedor" placeholder="Proveedor..." class="form-control" autocomplete="off" @bind-Value=@busquedaProveedor @oninput="(e) => FiltrarProveedor(e.Value.ToString())" />
					<ul class="list-group" style="max-height: 150px; overflow-y: auto;" hidden="@(!mostrarSugerenciasProveedor)">
						@foreach (var proveedor in proveedoresFiltrado)
						{
							<ComponentModel @key="proveedor.adprv_codigo" Proveedor="proveedor" />

							<li class="list-group-item list-group-item-action" @onclick="() => SeleccionarProveedor(proveedor)">
								@proveedor.adprv_nombre
							</li>
						}
					</ul>

				</div>


			</div>


		</div>
	</div>

	<!--ingreso productos-->
	<div class="container mt-5">

		<div class="row">
			<div class="col-6">




				<InputText id="producto" placeholder="Buscar producto..." class="form-control" autocomplete="off" @bind-Value=@busquedaProducto @oninput="(e) => FiltrarProductos(e.Value.ToString())" />
				<ul class="list-group" style="max-height: 150px; overflow-y: auto;" hidden="@(!mostrarSugerencias)">
					@foreach (var producto in productosFiltrados)
					{
						<ComponentModel @key="producto.adpro_codigo" Producto="producto" />

						<li class="list-group-item list-group-item-action" @onclick="() => SeleccionarProducto(producto)">
							@producto.adpro_descripcion
						</li>
					}
				</ul>


			</div>



		</div>

	</div>
	<!--DETALLE DE COMPRAS-->

	<div class="container mt-5">
		<div class="border p-4 rounded">

			<div class="table-responsive">
				<table class="table table-striped table-bordered table-hover" style="font-size: 12px;">
					<thead>
						<tr>
							<th>DESCRIPCION</th>
							<th>CANTIDAD</th>
							<th>VALOR</th>
							<th>IVA</th>
							<th>TOTAL</th>
							<th>ELIMINAR</th>
						</tr>
					</thead>
					<tbody>

						@foreach (var trxDetalle in listDetalleTrx)
						{
							<tr>

								<td>@trxDetalle.adpro_nombre</td>

								<td>
									<input type="number"
										   @bind="trxDetalle.adtc_cantidad"
										   @bind:event="oninput"
										   class="form-control form-control-sm"
										   @onchange="() => ActualizarTotales(trxDetalle)"
										   min="0" />
								</td>

								<td>
									<input type="number"
										   step="0.01"
										   @bind="trxDetalle.adtc_precioUnitario"
										   @bind:event="oninput"
										   @onchange="() => ActualizarTotales(trxDetalle)"
										   class="form-control form-control-sm"
										   min="0" />
								</td>



								<td>@trxDetalle.adtc_iva</td>
								<td>@trxDetalle.adtc_precio_total</td>

								<td>
									<!-- Botón de editar -->
									<button class="btn btn-success btn-sm" style="padding: 0.1rem 0.3rem; font-size: 0.75rem;" @onclick="() => EliminarDetalle(trxDetalle)">
										<i class="fas fa-remove"></i>
									</button>

								</td>

							</tr>
						}


					</tbody>
				</table>
			</div>



		</div>
	</div>

	<div class="container mt-5">
		<div class="border p-4 rounded">

			<div class="row">

				<div class="col-md-6">

				<textarea id="comentario" name="comentario" class="form-control form-control-sm small-font-input" @bind="cabeceraCompra.adcom_observacion" rows="3" cols="40">

					</textarea>

				</div>


			<div class="col-md-6">
				<div class="row align-items-center mb-2">
					<div class="col-md-4">
						<label for="adcom_subtotal" class="form-label mb-0 text-md-end">Subtotal:</label>
					</div>
					<div class="col-md-8">
						<input type="text" id="adcom_subtotal" class="form-control text-end" @bind="cabeceraCompra.adcom_subtotal" disabled />
					</div>
				</div>

				<div class="row align-items-center mb-2">
					<div class="col-md-4">
						<label for="adcom_iva" class="form-label mb-0 text-md-end">IVA:</label>
					</div>
					<div class="col-md-8">
						<input type="text" id="adcom_iva" class="form-control text-end" @bind="cabeceraCompra.adcom_iva" disabled />
					</div>
				</div>

				<div class="row align-items-center mb-2">
					<div class="col-md-4">
						<label for="adcom_total" class="form-label mb-0 text-md-end">Total:</label>
					</div>
					<div class="col-md-8">
						<input type="text" id="adcom_total" class="form-control text-end" @bind="cabeceraCompra.adcom_total" disabled />
					</div>
				</div>

			</div>
			
			<div class="col-md-4">

				<!-- Botón Guardar -->
				<button class="btn btn-primary" @onclick="() => GuardarCompra()">Guardar</button>

			</div>


			</div>


		</div>
	</div>


@code {

	private bool mostrarMensaje = false, mesageError = false;
	private string busquedaProducto = string.Empty;
	private List<Productos> productos;
	private List<Productos> productosFiltrados = new();
	//proveedores
	private List<Proveedor> proveedores;
	private List<Proveedor> proveedoresFiltrado = new();
	private string busquedaProveedor = string.Empty;
	private Proveedor? proveedorSeleccionado;
	//
	private bool mostrarSugerencias = false;
	private bool mostrarSugerenciasProveedor = false;
	private bool _cargado = false;
	private string idUser;
	private Productos? productoSeleccionado;
	//trxProductos
	private string tipoIngreso = "5A90D116-E4E6-4174-9506-314B4DAEBCC0", strMensajeMostrar;
	private DateTime fechaCompra;
	private TransaccionesProductos NewTrxProductos = new TransaccionesProductos();
	private DetalleCompra newDetalleTrx = new DetalleCompra();
	private List<DetalleCompra> listDetalleTrx = new List<DetalleCompra>();
	private List<TipoTrxProducto> tipoTrxProductos = new List<TipoTrxProducto>();
	//negocio
	private int negocioId;
	private bool isCargando = false; // <- bandera para mostrar el spinner
	private CabeceraCompra cabeceraCompra;

	[Parameter]
	public EventCallback<bool> OnFormSubmitted { get; set; } // Este EventCallback notifica al padre

	protected override async Task OnInitializedAsync()
	{

		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
		var user = authState.User;
		var userClaims = user.Identities.First().Claims.ToList();
		idUser = userClaims[0].Value;
		negocioId = serviceUser.getIdNegocioByUser(idUser);

		cabeceraCompra = new CabeceraCompra();



		cabeceraCompra.adbu_code = negocioId;
		productos = await productoServices.getAllProductosAsync();
		proveedores = await proveedorService.getAllProveedorAsync(negocioId);
		tipoTrxProductos = tipoTrx.getAllTipoTrx();
		//Para que cargue solo transacciones de ingreso
		tipoTrxProductos = tipoTrxProductos.Where(t => t.adtr_signo > 0).ToList();

	}

	private async void SeleccionarProducto(Productos producto)
	{
		productoSeleccionado = producto;
		busquedaProducto = producto.adpro_descripcion;
		await CargarDetalle(producto);

		//posterior a cargar detalle se borra el producto seleccionado
		busquedaProducto = string.Empty;


		mostrarSugerencias = false;
	}


	private void FiltrarProductos(string busqueda)
	{
		if (string.IsNullOrWhiteSpace(busqueda))
		{
			productosFiltrados.Clear();
			mostrarSugerencias = false;
			return;
		}

		productosFiltrados = productos
			.Where(p => p.adpro_descripcion.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
			.ToList();

		mostrarSugerencias = productosFiltrados.Any();
	}

	//proveedores
	private void SeleccionarProveedor(Proveedor proveedor)
	{
		proveedorSeleccionado = proveedor;
		busquedaProveedor = proveedor.adprv_nombre;
		mostrarSugerenciasProveedor = false;
	}

	private void FiltrarProveedor(string busqueda)
	{
		if (string.IsNullOrWhiteSpace(busqueda))
		{
			proveedoresFiltrado.Clear();
			mostrarSugerenciasProveedor = false;
			return;
		}

		proveedoresFiltrado = proveedores
			.Where(p => p.adprv_nombre.Contains(busqueda, StringComparison.OrdinalIgnoreCase))
			.ToList();

		mostrarSugerenciasProveedor = proveedoresFiltrado.Any();
	}

	private async Task<int> CargarDetalle(Productos producto)

	{
		try
		{
			//se valida que se haya seleccionado un tipo de trx
			if (tipoIngreso.Equals("seleccionar"))
			{
				mesageError = true;
				strMensajeMostrar = "Se debe selecionar tipo transaccion!";

				await Task.Delay(1000);
				mesageError = false;
				StateHasChanged();
				return 0;
			}

			//SE VALIDA QUE EXISTA YA COLOCADO EL VALOR DE PROVEEDOR
			if (proveedorSeleccionado != null)
			{
				//no debe existir el producto
				if (findProduct(producto.adpro_codigo))
				{
					mesageError = true;
					strMensajeMostrar = "El producto ya se encuentra en el detalle";

					await Task.Delay(1000);
					mesageError = false;
					StateHasChanged();
					return 0;

				}
				else
				{
					newDetalleTrx = new DetalleCompra();
					newDetalleTrx.adpro_nombre = producto.adpro_descripcion;
					newDetalleTrx.adpro_codigo = producto.adpro_codigo;
					newDetalleTrx.adtc_precioUnitario = producto.adpro_valor;
					newDetalleTrx.adtc_iva = newDetalleTrx.adtc_precioUnitario * (producto.adpro_valor_iva/100);
					listDetalleTrx.Add(newDetalleTrx);


					return 1;

				}




			}
			else
			{
				mesageError = true;
				strMensajeMostrar = "No se ha seleccionado proveedor!";

				await Task.Delay(1000);
				mesageError = false;
				StateHasChanged();
				return 0;


			}


		}
		catch (Exception ex)
		{
			mesageError = true;
			strMensajeMostrar = "ERROR "+ex.Message +"CONTACTE CON EL ADMINISTRADOR DEL SISTEMA!";

			await Task.Delay(1000);
			mesageError = false;
			StateHasChanged();
			return 0;

		}

	}

	private bool findProduct(Guid adproCodigo)
	{
		bool find = false;

		foreach (var detalle in listDetalleTrx)
		{
			if (adproCodigo.Equals(detalle.adpro_codigo)) find = true;
		}


		return find;

	}

	private void EliminarDetalle(DetalleCompra detalleEliminar)
	{
		listDetalleTrx.Remove(detalleEliminar);

		//se encera siempre para que se vuelva a calcular.
		cabeceraCompra.adcom_subtotal = 0;
		cabeceraCompra.adcom_iva = 0;
		cabeceraCompra.adcom_total = 0;


		foreach (var detalle in listDetalleTrx)
		{
			cabeceraCompra.adcom_subtotal += detalle.adtc_precio_total;
			cabeceraCompra.adcom_iva += detalle.adtc_iva;
			cabeceraCompra.adcom_total = cabeceraCompra.adcom_subtotal + cabeceraCompra.adcom_iva;
		}


	}

	private void ActualizarTotales(DetalleCompra trxDetalleAct)
	{
			
		decimal valorIva = (productoSeleccionado.adpro_valor_iva / 100);	

		

		trxDetalleAct.adtc_iva = trxDetalleAct.adtc_cantidad * trxDetalleAct.adtc_precioUnitario * valorIva;
		trxDetalleAct.adtc_precio_total = trxDetalleAct.adtc_cantidad * trxDetalleAct.adtc_precioUnitario;

		//se encera siempre para que se vuelva a calcular.
		cabeceraCompra.adcom_subtotal = 0;
		cabeceraCompra.adcom_iva = 0;
		cabeceraCompra.adcom_total = 0;

		//se recorre para el calculo 
		foreach (var detalle in listDetalleTrx)
		{
			cabeceraCompra.adcom_subtotal += detalle.adtc_precio_total;
			cabeceraCompra.adcom_iva += detalle.adtc_iva;
			cabeceraCompra.adcom_total = cabeceraCompra.adcom_subtotal + cabeceraCompra.adcom_iva;
		}

	}

	private async void GuardarCompra()
	{
		try
		{
			if (listDetalleTrx.Count > 0)
			{

				//se debe enviar a guardar primeramente la cabecera
				cabeceraCompra.adcom_userUpdate = idUser;
				cabeceraCompra.adprv_codigo = proveedorSeleccionado.adprv_codigo;
				await serviceCabeceraCompra.guardarCabeceraCompra(cabeceraCompra,true);

				//una vez guardado la cabecera se setea el detalle con la clave de la cabecera
				for (int i= 0; i < listDetalleTrx.Count; i++)
				{
					listDetalleTrx[i].adcom_codigo = cabeceraCompra.adcom_codigo;

				}
				//se guarda detalle
				await serviceDetalleCompra.guardarDetalleCompra(listDetalleTrx,true);

				//se realiza la actualizacion sobre el producto e insert transaccional
				await serviceTrxProductos.InsertUpdateTrxProducts("ENTRADA",cabeceraCompra.adcom_codigo);

				//se setea las listas y la cabecera
				cabeceraCompra = new CabeceraCompra();
				listDetalleTrx.Clear();

				//Si todo es exitoso se envia a cerrar pasandole el exito o fracaso al padre.
				await OnFormSubmitted.InvokeAsync(true); // Pasar 'true' indica éxito

				/*mostrarMensaje = true;
				strMensajeMostrar = "Registrado con exito!";
				await Task.Delay(1000);
				mostrarMensaje = false;
				StateHasChanged();*/


			}
			else
			{
				await OnFormSubmitted.InvokeAsync(false); // Pasar 'true' indica éxito

				mesageError = true;
				strMensajeMostrar = "No se puede guardar sin detalles de productos!";

				await Task.Delay(1000);
				mesageError = false;
				StateHasChanged();

			}



		}
		catch (Exception ex)
		{
			mesageError = true;
			strMensajeMostrar = ex.Message;

			await Task.Delay(1000);
			mesageError = false;
			StateHasChanged();

		}


	}



}
