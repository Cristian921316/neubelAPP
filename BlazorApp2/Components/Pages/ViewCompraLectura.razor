@using BlazorApp2.Services
@using BlazorApp2.Models
@using Microsoft.AspNetCore.Authorization
@using System.Diagnostics
@rendermode InteractiveServer
@inject ServiceCabeceraCompra serviceCabeceraCompra
@inject ServiceDetalleCompra serviceDetalleCompra

<div class="container mt-4">
    

    <div class="card mb-4">
        
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="factura" class="form-label">Factura</label>
                    <input type="text" id="factura" class="form-control" @bind="factura" disabled>
                </div>
                <div class="col-md-6">
                    <label for="comprador" class="form-label">Comprador</label>
                    <input type="text" id="comprador" class="form-control" @bind="comprador" disabled>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-md-6">
                    <label for="registro" class="form-label">Fecha de Registro</label>
                    <input type="date" id="registro" class="form-control" @bind="registro" disabled>
                </div>
                <div class="col-md-6">
                    <label for="proveedor" class="form-label">Proveedor</label>
                    <input type="text" id="proveedor" class="form-control" @bind="compra.adprv_codigo" disabled>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            Detalle de Productos
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio Unitario</th>
                            <th>Iva</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trxDetalle in detalles)
                        {
                            <tr>

                                <td>@trxDetalle.adpro_nombre</td>
                                <td>@trxDetalle.adtc_cantidad</td>
                                <td>@trxDetalle.adtc_precioUnitario</td>
                                <td>@trxDetalle.adtc_iva</td>
                                <td>@trxDetalle.adtc_precio_total</td>

                            </tr>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>

    
</div>




@code {

    [Parameter]
    public string factura { get; set; } // Este EventCallback notifica al padre
    [Parameter]
    public string comprador { get; set; } // Este EventCallback notifica al padre
    [Parameter]
    public string observacion { get; set; } // Este EventCallback notifica al padre
    [Parameter]
    public DateTime? registro { get; set; } // Este EventCallback notifica al padre
    [Parameter]
    public Guid idCompra { get; set; } // Este EventCallback notifica al padre


    private CabeceraCompra compra = new CabeceraCompra();
    private List<DetalleCompra> detalles = new List<DetalleCompra>();

    protected override async Task OnInitializedAsync()
    {

        detalles = await serviceDetalleCompra.GetDetalleComprasAsync(idCompra);

    }

}
